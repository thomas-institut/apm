#
# env file for dev containers
#

# Use a unique project name in each git worktree.
COMPOSE_PROJECT_NAME=apm-main

# Host ports for services accessed from the host machine.
NGINX_PORT=8888
FONTS_PORT=4567

# URL of the ZIP archive containing the fontserver directory.
FONTS_ZIP_URL=https://one.thomas.uni-koeln.de/public.php/dav/files/9AtFxawXDDcZ4de/?accept=zip

# Repo root relative to this folder
REPO_ROOT='../../..'

#
# All paths below relative to repo root
#

DEV_TMP='dev-tmp'
APM_SRC='apps/apm'
SHARED_PHP_SRC='apps/shared-php'