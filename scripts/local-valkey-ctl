#!/usr/bin/env bash

CONTAINER_NAME="valkey-local"
PORT=6379
IMAGE_NAME=valkey/valkey:alpine

usage() {
    echo "Usage: $0 {start|stop} [-c container_name] [-p local_port]" >&2
}

ACTION="$1"
case "$ACTION" in
    start|stop) shift ;;
    *) usage; exit 2 ;;
esac

while getopts ":c:p:" option; do
    case "$option" in
        c) CONTAINER_NAME="$OPTARG" ;;
        p) PORT="$OPTARG" ;;
        \?) usage; exit 2 ;;
        :) echo "Option -$OPTARG requires an argument." >&2; exit 2 ;;
    esac
done

if [[ "$ACTION" == "stop" ]]; then
    docker stop "$CONTAINER_NAME"
elif docker container inspect "$CONTAINER_NAME" >/dev/null 2>&1; then
    echo "Starting existing Valkey container..."
    docker start "$CONTAINER_NAME"
else
    echo "Creating and starting Valkey container..."
    docker run -d  --name "$CONTAINER_NAME" -p "$PORT:6379"  $IMAGE_NAME
fi
